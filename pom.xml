<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.pigfox</groupId>
  <artifactId>spring-boot</artifactId>
  <version>1.0.0</version>
  <name>spring-boot</name>
  <description>API-first blockchain ledger node: EVM anchoring, secp256k1 signing, zero-trust JWT, Kafka events, OTLP telemetry</description>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>2.8.17</springdoc.version>

    <!-- Transitive dependencies pinned ahead of what the Boot BOM manages, because the
         versions it manages carry HIGH or CRITICAL advisories that the CI Trivy gate
         rejects. Each is a patch-level bump within the same minor line, so the BOM's
         compatibility guarantees still hold. Drop an override once the BOM catches up. -->
    <tomcat.version>10.1.59</tomcat.version>
    <spring-kafka.version>3.3.16</spring-kafka.version>
    <micrometer.version>1.15.12</micrometer.version>
    <!-- Pulled in by web3j, which the Boot BOM does not manage at all. -->
    <bouncycastle.version>1.85.2</bouncycastle.version>
    <web3j.version>4.12.2</web3j.version>
    <jacoco.version>0.8.12</jacoco.version>
    <pitest.version>1.30.0</pitest.version>
    <pitest.junit5.version>1.2.3</pitest.junit5.version>
    <!-- The suite covers every line and branch; the gate holds it there. -->
    <jacoco.line.minimum>1.00</jacoco.line.minimum>
    <jacoco.branch.minimum>1.00</jacoco.branch.minimum>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- web3j depends on 1.78.1, which has a CRITICAL advisory. Managed here rather than
           excluded because the crypto primitives genuinely are needed. -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Backs the TimedAspect that makes @Timed work on the service layer. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- API-first: springdoc renders the implementation so it can be diffed against
         src/main/resources/openapi/asset-api.yaml (see OpenApiContractTest). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Blockchain: JSON-RPC client, keccak256, secp256k1 sign/recover. -->
    <dependency>
      <groupId>org.web3j</groupId>
      <artifactId>core</artifactId>
      <version>${web3j.version}</version>
      <exclusions>
        <!-- web3j's Unix-socket IPC transport, and the native JNR stack behind it. This
             node talks to the chain over HTTP (see Web3Config), so the whole tree is dead
             weight in the image and extra surface for the container scan to worry about. -->
        <exclusion>
          <groupId>com.github.jnr</groupId>
          <artifactId>jnr-unixsocket</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Telemetry: Prometheus scrape endpoint plus OTLP span export. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Mutation testing, behind a profile and bound to no lifecycle phase, so it runs only
      when asked for by name: ./mvnw -P mutation org.pitest:pitest-maven:mutationCoverage,
      or more usually ./mutants.sh. A normal build and every existing CI job are untouched
      in both speed and outcome.

      Report only, deliberately. There is no mutationThreshold and nothing fails on a low
      score: the first job of this profile is to measure the suite as it stands, and a gate
      added before anyone has read the survivors would just be a number to game.
    -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest.junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.pigfox.springboot.*</param>
              </targetClasses>
              <targetTests>
                <param>com.pigfox.springboot.*</param>
              </targetTests>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <!-- A stable path, so mutants.sh can find the report without globbing dates. -->
              <timestampedReports>false</timestampedReports>
              <threads>8</threads>
              <!-- Several suites boot a Spring context, which is slow enough that PIT's
                   default 4s allowance would report timeouts that are really just startup. -->
              <timeoutConstant>30000</timeoutConstant>
              <failWhenNoMutations>false</failWhenNoMutations>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
